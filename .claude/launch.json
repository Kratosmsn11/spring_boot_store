{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Spring Boot App",
      "runtimeExecutable": "mvnw.cmd",
      "runtimeArgs": ["spring-boot:run"],
      "port": 8080
    },
    {
      "name": "Podman Infrastructure (Postgres + Keycloak + Kafka)",
      "runtimeExecutable": "podman",
      "runtimeArgs": ["compose", "up"],
      "port": 9090
    },
    {
      "name": "Keycloak",
      "runtimeExecutable": "podman",
      "runtimeArgs": ["compose", "up", "keycloak"],
      "port": 9090
    },
    {
      "name": "PostgreSQL",
      "runtimeExecutable": "podman",
      "runtimeArgs": ["compose", "up", "postgres_db"],
      "port": 5432
    },
    {
      "name": "Kafka + Zookeeper",
      "runtimeExecutable": "podman",
      "runtimeArgs": ["compose", "up", "zookeeper", "kafka"],
      "port": 9092
    }
  ]
}
